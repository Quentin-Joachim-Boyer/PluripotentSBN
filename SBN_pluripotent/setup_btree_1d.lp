% setup_btree_1d.lp
% Selects the correct btree/4 fact from the decomposition vector constants.
% Generated by gen_setup_btree.py
%
% Usage:
%   clingcon N -c d=1 -c v0=X ... -c v1=Y \
%       setup_btree_1d.lp btree_constructor.lp

#const d = 1.
#const v0 = 0.
#const v1 = 0.

% 2 valid decomposition vectors for d=1

% vec = <0,2>
btree(btree(nil,nil,0,nil),btree(nil,nil,0,nil),1,nil) :- v0 = 2, v1 = 0.

% vec = <1,0>
btree(nil,nil,1,nil) :- v0 = 0, v1 = 1.
