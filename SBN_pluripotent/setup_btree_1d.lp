% setup_btree_1d.lp
% Selects ONE btree/4 fact per decomposition vector (first orientation only).
% Generated by gen_setup_btree.py
%
% WARNING: This file fixes one arbitrary tree orientation per vector.
% Asymmetric vectors admit multiple valid orientations; only the first is
% encoded here, so enumeration via these fixed trees is INCOMPLETE.
% Use PSBN_undercontrol_treeinsolver.lp for complete enumeration.
%
% Usage:
%   clingcon N -c d=1 -c v0=X ... -c v1=Y \
%       setup_btree_1d.lp btree_constructor.lp

#const d = 1.
#const v0 = 0.
#const v1 = 0.

% 2 valid decomposition vectors for d=1

% vec = <0,2>  (1 orientation(s), only first used)
btree(btree(nil,nil,0,nil),btree(nil,nil,0,nil),1,nil) :- v0 = 2, v1 = 0.

% vec = <1,0>  (1 orientation(s), only first used)
btree(nil,nil,1,nil) :- v0 = 0, v1 = 1.
